{
  "name": "ragflow-mock-server",
  "version": "1.0.0",
  "description": "Standalone MSW mock server for all RAGFlow services",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev":   "tsx watch src/server.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "msw": "^2.4.0",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "tsx": "^4.7.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*"]
}
