  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "msw": "^2.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.0.0",
    "nodemon": "^3.1.14",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0"
  }
}
