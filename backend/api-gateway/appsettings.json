{
  "Jwt": {
    "Issuer": "ragflow.identity",
    "Audience": "ragflow.api",
    "Secret": "injected-from-env",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "__DEVELOPER_GUIDE__": [
    "1. ROUTES (Inbound Traffic):",
    "   - Add a new unique route object under 'Routes' (e.g., 'AdminRoute').",
    "   - Set 'ClusterId' to match your corresponding backend cluster name exactly.",
    "   - Set 'Match': { 'Path': '/api/v1/your-service-prefix/{**catch-all}' }.",
    "     CRITICAL: The '{**catch-all}' wildcard ensures all sub-paths (like /login or /create) are forwarded.",
    "2. CLUSTERS (Outbound Routing via Docker Service Discovery):",
    "   - Add a new cluster object under 'Clusters' named exactly after your 'ClusterId'.",
    "   - Under 'Destinations', use your specific container service name as the key.",
    "   - For 'Address': Use 'http://<DOCKER_SERVICE_NAME>:<INTERNAL_CONTAINER_PORT>'.",
    "     WARNING: Do NOT use localhost or the external host port. Look at your service's Dockerfile",
    "     (EXPOSE) or docker-compose.yml to find its internal container port (e.g., 3000, 4000, 8080).",
    "3. RATE LIMITING (Traffic Control):",
    "   - To protect your service from abuse, add '\"RateLimiterPolicy\": \"<PolicyName>\"' inside your Route object.",
    "   - Use 'StandardPolicy': For normal authenticated APIs (Limits to 100 requests/minute per User ID).",
    "   - Use 'StrictPolicy': For sensitive or unauthenticated APIs like login/signup (Limits to 5 requests/minute per IP address)."
  ],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDbSettings": {
    "ConnectionString": "mongodb://ragflow_admin:infini_rag_flow@mongodb:27017",
    "DatabaseName": "AuditLogsDb",
    "CollectionName": "GatewayLogs"
  },
  "ReverseProxy": {
    "Routes": {
      "IdentityRoute": {
        "ClusterId": "IdentityCluster",
        "RateLimiterPolicy": "StrictPolicy",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        },
        "AuthorizationPolicy": "Anonymous"
      },
      "FileServiceRoute": {
        "ClusterId": "FileServiceCluster",
        "RateLimiterPolicy": "StandardPolicy",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/v1/files/{**catch-all}"
        }
      },
      "AdminAuthRoute": {
        "ClusterId": "AdminCluster",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "StrictPolicy",
        "Match": {
          "Path": "/api/v1/admin/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/admin"
          },
          {
            "PathPrefix": "/api/v1"
          }
        ]
      },
      "AdminRoute": {
        "ClusterId": "AdminCluster",
        "RateLimiterPolicy": "StandardPolicy",
        "Match": {
          "Path": "/api/v1/admin/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/admin"
          },
          {
            "PathPrefix": "/api/v1"
          }
        ]
      },
      "UsersRoute": {
        "ClusterId": "IdentityCluster",
        "RateLimiterPolicy": "StandardPolicy",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        }
      },
      "NodeSearchRoute": {
        "ClusterId": "NodeSearchCluster",
        "RateLimiterPolicy": "StandardPolicy",
        "Match": {
          "Path": "/api/v1/searches/{**catch-all}"
        },
        "AuthorizationPolicy": "Default"
      },
      "JavaDatasetRoute": {
        "ClusterId": "JavaDatasetCluster",
        "RateLimiterPolicy": "StandardPolicy",
        "Match": {
          "Path": "/api/v1/dataset/{**catch-all}"
        },
        "AuthorizationPolicy": "Default"
      },
      "SearchConfigRoute": {
        "ClusterId": "JavaSearchCluster",
        "RateLimiterPolicy": "StandardPolicy",
        "Match": {
          "Path": "/api/v1/searches/{**catch-all}"
        },
        "AuthorizationPolicy": "Default"
      },
      "UnifiedSearchRoute": {
        "ClusterId": "JavaSearchCluster",
        "RateLimiterPolicy": "StandardPolicy",
        "Match": {
          "Path": "/api/v1/search/{**catch-all}"
        },
        "AuthorizationPolicy": "Default"
      },
      "KnowledgeBaseRoute": {
        "ClusterId": "KnowledgeBaseCluster",
        "RateLimiterPolicy": "StandardPolicy",
        "Match": {
          "Path": "/api/v1/knowledgebases/{**catch-all}"
        },
        "AuthorizationPolicy": "Default"
      },
      "DotnetDocumentRoute": {
        "ClusterId": "DotnetDocumentCluster",
        "RateLimiterPolicy": "StandardPolicy",
        "Match": {
          "Path": "/api/v1/documents/{**catch-all}"
        },
        "AuthorizationPolicy": "Default"
      }
      },
    "Clusters": {
      "JavaSearchCluster": {
        "Destinations": {
          "search-service": {
            "Address": "http://search-service:9407"
          }
        }
      },
      "IdentityCluster": {
        "Destinations": {
          "identity-service": {
            "Address": "http://identity-service:3000"
          }
        }
      },
      "FileServiceCluster": {
        "Destinations": {
          "dotnet-file-service": {
            "Address": "http://dotnet-file-service:8080"
          }
        }
      },
      "KnowledgeBaseCluster": {
        "Destinations": {
          "knowledgebase-service": {
            "Address": "http://knowledgebase-service:8080"
          }
        }
      },
      "AdminCluster": {
        "Destinations": {
          "admin-auth-service": {
            "Address": "http://admin-auth-service:3000"
          }
        }
      },
      "NodeSearchCluster": {
        "Destinations": {
          "search-service": {
            "Address": "http://search-service:3000"
          }
        }
      },
      "JavaDatasetCluster": {
        "Destinations": {
          "dataset-service-java": {
            "Address": "http://dataset-service-java:8083"
          }
        }
      },
      "DotnetDocumentCluster": {
        "Destinations": {
          "document-service-dotnet": {
            "Address": "http://document-service-dotnet:8081"
          }
        }
      }
    }
  }
}