generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Dataset {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id") @db.VarChar(36)
  name         String    @db.VarChar(128)
  embdId       String    @map("embd_id") @db.VarChar(36)
  tenantEmbdId String    @map("tenant_embd_id") @db.VarChar(36)
  createdBy    String    @map("created_by") @db.VarChar(36)
  pipelineId   String?   @map("pipeline_id") @db.VarChar(36)
  status       String    @default("1") @db.Char(1)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([createdBy, status, name])
  @@map("knowledgebase")
}