# Database Configuration
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:your_db_password_here@localhost:5455/identity_db"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT=6380
REDIS_PASSWORD="your_redis_password_here" #can find it in the docker compose file 

# Application Config
PORT=4002

# JWT Security 
JWT_SECRET="your_super_secret_jwt_key_here"
JWT_ACCESS_EXPIRATION='1h'
JWT_REFRESH_EXPIRATION='7d'

# Cookie Max Age in Milliseconds (7 days = 604800000)
REFRESH_COOKIE_MAX_AGE='604800000'