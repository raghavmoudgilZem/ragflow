#below is the configuration for dev container setup
# Application Port
PORT=4002
NODE_ENV=development

# MySQL Container Connection
DATABASE_URL="mysql://root:infini_rag_flow@mysql:3306/identity_db?allowPublicKeyRetrieval=true"

# Redis Container Connection
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_PASSWORD="infini_rag_flow"

# JWT Configuration
JWT_SECRET="secret"
JWT_ACCESS_EXPIRATION="1h"
JWT_REFRESH_EXPIRATION="7d"
REFRESH_COOKIE_MAX_AGE="604800000"